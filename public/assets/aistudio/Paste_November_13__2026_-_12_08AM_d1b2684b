#sh:before{content:"";display:block;width:36px;height:4px;background:var(--l);border-radius:2px;margin:4px auto 12px}
#ts{position:fixed;bottom:86px;left:12px;right:12px;max-width:456px;margin:auto;z-index:10}.ts{background:var(--s2);border:1px solid var(--g);border-radius:12px;padding:10px 12px;display:flex;justify-content:space-between;align-items:center;margin-top:6px;font-size:12.5px}.ts button{background:none;border:0;color:var(--g);font:inherit;font-weight:800;cursor:pointer}
:focus-visible{outline:2px solid var(--g);outline-offset:2px}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
