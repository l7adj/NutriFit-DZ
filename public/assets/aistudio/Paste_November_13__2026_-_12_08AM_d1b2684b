var FOODS=[['chk','🍗','صدر دجاج',165,31,0,3.6,0,45,[]],['sal','🐟','سلمون',206,22,0,12,0,140,['fish']],['tun','🐟','تونة بالماء',116,26,0,.8,0,90,['fish']],['egg','🥚','بيض مسلوق',155,13,1.1,11,0,25,['eggs']],['ric','🍚','أرز أبيض',130,2.7,28,.3,.4,12,[]],['pas','🍝','معكرونة',158,5.8,31,.9,1.8,15,['gluten']],['swp','🍠','بطاطا حلوة',90,2,21,.2,3.3,10,[]],['oat','🥣','شوفان',71,2.5,12,1.5,1.7,18,['gluten']],['len','🥘','عدس',116,9,20,.4,7.9,12,[]],['bro','🥦','بروكلي',35,2.4,7.2,.4,3.3,15,[]],['oil','🫒','زيت زيتون',884,0,0,100,0,60,[]],['alm','🌰','لوز',579,21,22,50,12.5,120,['nuts']],['cot','🧀','جبن قريش',98,11,3.4,4.3,0,40,['milk']],['brd','🍞','خبز أسمر',247,13,41,3.4,7,8,['gluten']]].map(function(a){return{id:a[0],e:a[1],n:a[2],k:a[3],p:a[4],c:a[5],f:a[6],fi:a[7],pr:a[8],al:a[9]}});
var DISHES=[['d1','🍗','دجاج مع أرز وبروكلي',[['chk',150],['ric',200],['bro',100]]],['d2','🐟','سلمون مع بطاطا حلوة',[['sal',150],['swp',200],['bro',100]]],['d3','🥘','عدس مع أرز وزيت زيتون',[['len',250],['ric',150],['oil',8]]],['d4','🍝','تونة مع معكرونة',[['tun',120],['pas',200],['oil',8]]],['d5','🥣','شوفان مع بيض ولوز',[['oat',250],['egg',100],['alm',20]]],['d6','🧀','جبن قريش وخبز ولوز',[['cot',200],['brd',60],['alm',20]]]];
var S,T,ZZ=0;
function FD(id){return FOODS.filter(function(f){return f.id==id})[0]}
function N(v){return Math.round(v||0)}function $(i){return document.getElementById(i)}
function save(){try{localStorage.nf3=JSON.stringify(S)}catch(e){}}
S=(function(){try{return JSON.parse(localStorage.nf3)}catch(e){}})()||{ob:0,sex:'m',age:28,h:178,w:80,lbm:0,rel:0,band:'A',pal:1.85,goal:'bulk',pct:10,al:[],fl:{preg:0,kid:0,dia:0,ed:0},sup:0,supg:0,meals:[],n:3,zone:150,ord:[],jr:[],cap:60,adh:100,cal:[],tab:'home',f:'d'};
function blocked(f){return f.al.filter(function(a){return S.al.indexOf(a)>=0})}
function dB(d){return d[3].some(function(x){return blocked(FD(x[0])).length})}
function alg(){var o={};new Intl.DateTimeFormat('en-CA',{timeZone:'Africa/Algiers',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(new Date()).forEach(function(p){o[p.type]=p.value});return{d:o.year+'-'+o.month+'-'+o.day,h:+o.hour,m:+o.minute}}
function add(d,n){var x=new Date(d+'T12:00:00Z');x.setUTCDate(x.getUTCDate()+n);return x.toISOString().slice(0,10)}
function dlv(){var a=alg(),c=a.h>=16,left=c?0:(16-a.h)*60-a.m;return{date:add(a.d,c?2:1),closed:c,left:left}}
function DT(s){var d=new Date(s+'T12:00:00Z');return['الأحد','الإثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'][d.getUTCDay()]+' '+d.getUTCDate()+'/'+(d.getUTCMonth()+1)}
function gate(){var x=S;if(x.age<18)return'العمر أقل من 18 سنة. لا نصدر خطة آلية للقاصرين، ويلزم ولي الأمر وأخصائي.';if(x.fl.preg||x.fl.kid||x.fl.dia||x.fl.ed)return'حالتك تتطلب مراجعة مختص قبل أي خطة غذائية. لا نصدر خطة آلية.';return''}
function calc(){var x=S,r={warn:[]},g=gate();if(g)return{err:g};
if(x.age>100||x.w<30||x.w>300||x.h<120||x.h>230)return{err:'أدخل عمرًا حتى 100 ووزنًا بين 30 و300 كغ وطولًا بين 120 و230 سم.'};
if(x.goal=='cut'&&x.w/Math.pow(x.h/100,2)<18.5)return{err:'مؤشر الكتلة أقل من 18.5، فهدف التنشيف محجوب.'};
var kat=x.lbm>0&&x.rel>=70;r.kat=kat;r.rmr=kat?370+21.6*x.lbm:10*x.w+6.25*x.h-5*x.age+(x.sex=='m'?5:-161);
r.tdee=r.rmr*x.pal;r.kcal=r.tdee*(1+x.pct/100);
if(x.pct<-25||x.pct>25)return{err:'الفائض أو العجز بين −25% و+25% فقط.'};
if(r.kcal<r.rmr)return{err:'الهدف ('+N(r.kcal)+' kcal) أقل من معدل الأيض أثناء الراحة ('+N(r.rmr)+'). خفّف العجز.'};
if(x.pct<-20)r.warn.push('عجز أكبر من 20%: لفترات قصيرة فقط.');
r.P=(x.goal=='cut'&&kat)?2.5*x.lbm:GOALS[x.goal][3]*x.w;r.pg=r.P/x.w;if(r.pg>3.1)r.warn.push('بروتين عالٍ جدًّا؛ تأكد من الترطيب ومن عدم وجود حالة كلوية معروفة.');
r.F=.25*r.kcal/9;r.C=(r.kcal-4*r.P-.25*r.kcal)/4;if(r.C<0)return{err:'البروتين والدهون يتجاوزان السعرات المستهدفة. عدّل الهدف.'};
r.cg=r.C/x.w;if(r.cg<3)r.warn.push('كارب منخفض جدًّا؛ قد يؤثر على الأداء.');if(r.cg>12)r.warn.push('كارب مرتفع جدًّا؛ راجع حجم التدريب.');
r.sc=Math.min(x.supg,.5*r.P);r.sp=x.sup?x.supg/r.P*100:0;r.ev=r.sp<=20?'مكمل خفيف':r.sp<=30?'توازن مثالي':r.sp<=40?'مقبول':r.sp<=50?'مرتفع':'مقصوص إلى 50%';r.fp=r.P-(x.sup?r.sc:0);return r}
function mac(m){var f=FD(m.id),q=m.g/100;return{k:f.k*q,p:f.p*q,c:f.c*q,f:f.f*q,fi:f.fi*q,pr:f.pr*q}}
function tot(){var t={k:0,p:0,c:0,f:0,fi:0,pr:0};S.meals.forEach(function(m){var a=mac(m);for(var q in t)t[q]+=a[q]});return t}
function price(){var t=tot(),h=t.pr*.07,s=200*S.n;return{i:t.pr,h:h,s:s,z:S.zone,t:Math.round(t.pr+h+s+S.zone)}}
/* مكونات الواجهة */
function ring(p,sz,col,inner){var r=sz/2-8,C=2*Math.PI*r;return '<div class=ringw style="width:'+sz+'px;height:'+sz+'px"><svg width='+sz+' height='+sz+'><circle cx='+sz/2+' cy='+sz/2+' r='+r+' fill=none stroke="#2b3322" stroke-width=9 /><circle cx='+sz/2+' cy='+sz/2+' r='+r+' fill=none stroke="'+col+'" stroke-width=9 stroke-linecap=round stroke-dasharray='+C+' stroke-dashoffset='+C*(1-Math.min(1,Math.max(0,p)))+' style="transition:stroke-dashoffset 1s"/></svg><div class=ringc>'+inner+'</div></div>'}
function bar(l,v,t,c){var p=t>0?Math.min(100,v/t*100):0;return '<div class=br><span>'+l+'</span><div><i style="width:'+p+'%;background:var(--'+c+')"></i></div><b>'+N(v)+' / '+N(t)+'</b></div>'}
