<script>
var BANDS={L:[1.4,1.69,1.55,'خفيف','مكتبي أو حركة قليلة، وتدريب يومان'],A:[1.7,1.99,1.85,'نشط','حركة يومية وتدريب 3 إلى 5 أيام'],V:[2,2.4,2.2,'شديد','عمل بدني شاق وتدريب مكثف يوميًا']};
var GOALS={bulk:['بناء عضل','فائض +10%',10,1.8],recomp:['إعادة تشكيل','عجز −10%',-10,1.8],cut:['تنشيف','عجز −20%',-20,2],maint:['ثبات وأداء','بلا فائض ولا عجز',0,1.6]};
