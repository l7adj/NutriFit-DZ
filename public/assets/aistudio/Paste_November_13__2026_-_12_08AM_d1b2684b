var AL={gluten:'غلوتين',eggs:'بيض',fish:'سمك',milk:'حليب',nuts:'مكسرات'};
var ZONES=[[0,'استلام من المطبخ'],[150,'المنطقة 1 · الشراقة · دالي إبراهيم · أولاد فايت'],[300,'المنطقة 2 · عين البنيان · سطاوالي · الدرارية'],[500,'المنطقة 3 · زرالدة وما بعدها']];
var TABS=[['home','🏠','اليوم'],['menu','🍽️','الوجبات'],['cart','🛒','السلة'],['jr','📈','تطوري'],['me','👤','حسابي']];
