/* التهيئة */
var V={};
V.ob=function(){var s=S.ob,h='<div class=dots>'+[1,2,3,4,5].map(function(i){return '<i class="'+(i<=s?'on':'')+'"></i>'}).join('')+'</div>',bk=s>0?'<button class="btn gh" onclick="go('+(s-1)+')">رجوع</button>':'';
if(s==0)return '<div class=hero style="padding-top:50px"><div style="font-size:54px">🥗</div><h1 style="margin:14px 0 8px">NutriFit DZ</h1><p style="color:var(--g2);font-size:17px">طعام محسوب بالغرام، يصلك صباحًا.</p></div><div class=card><p>1. نحسب احتياجك من السعرات والماكروز بمصادر علمية معلنة.</p><p>2. تبني وجباتك بالغرام وتوزعها على يومك.</p><p>3. نطبخ بعد تأكيدك فقط ونوصلها في الصباح.</p></div><button class=btn onclick="go(1)">ابدأ</button><div class=sm style="text-align:center;margin-top:10px">أداة تغذية رياضية، وليست بديلًا عن الطبيب.</div>';
